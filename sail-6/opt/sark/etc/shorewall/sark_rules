ACCEPT net:$LAN $FW tcp 5060 - - # TCP SIP
ACCEPT net:$LAN $FW tcp 5061 - - # TCP SIP
# HTTP from LAN only (phones/provisioning). Public :80 is opened temporarily
# by le-port80-open.sh for Let's Encrypt HTTP-01, then closed again.
ACCEPT net:$LAN $FW tcp 80 - - # HTTP LAN
ACCEPT net $FW tcp 443 - - # HTTPS
ACCEPT net $FW tcp 22 - - # SSH
ACCEPT net:$LAN $FW udp 123 - - # NTP
ACCEPT net:$LAN $FW tcp 389 - - # LDAP
ACCEPT net:$LAN $FW udp 389 - - # LDAP
ACCEPT net:$LAN $FW udp 4569 - -  # IAX2
ACCEPT net:$LAN $FW udp 5060 - - 4/min:5 # SIP
ACCEPT net:$LAN $FW udp 10000:20000 - - # RTP
